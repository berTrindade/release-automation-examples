{
    "name": "node-release-poc",
    "version": "0.0.0-development",
    "description": "POC: Node.js release process with CI/CD, conventional commits, and semantic changelogs",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "node src/index.js",
        "lint": "eslint .",
        "test": "jest --runInBand",
        "build": "mkdir -p dist && npm pack --pack-destination dist",
        "semantic-release": "semantic-release",
        "prepare": "husky install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/berTrindade/node-release-poc.git"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^17.6.0",
        "@commitlint/config-conventional": "^17.6.0",
        "@semantic-release/changelog": "^6.0.0",
        "@semantic-release/git": "^10.0.0",
        "eslint": "^8.50.0",
        "husky": "^8.0.0",
        "jest": "^29.0.0",
        "lint-staged": "^14.0.0",
        "semantic-release": "^21.0.0",
        "supertest": "^6.3.3"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "git add"
        ]
    }
}