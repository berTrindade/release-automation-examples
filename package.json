{
    "name": "release-automation-examples",
    "version": "0.0.3",
    "description": "Comprehensive examples of automated release workflows: standard-version, semantic-release, release-please, and changesets",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "node src/index.js",
        "lint": "eslint .",
        "test": "jest --runInBand",
        "build": "mkdir -p dist && npm pack --pack-destination dist",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "npm run build",
        "prepare": "husky install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/your/repo.git"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@commitlint/cli": "^17.6.0",
        "@commitlint/config-conventional": "^17.6.0",
        "eslint": "^8.50.0",
        "husky": "^8.0.0",
        "jest": "^29.0.0",
        "lint-staged": "^14.0.0",
        "standard-version": "^9.5.0",
        "supertest": "^6.3.3"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "git add"
        ]
    },
    "standard-version": {
        "scripts": {
            "postchangelog": "git add CHANGELOG.md"
        }
    }
}
